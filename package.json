{
    "name": "live-gallery",
    "version": "1.5.7",
    "description": "Monitor multiple live streams from YouTube, JW, Facebook, and other sources.",
    "main": "dist/main.js",
    "scripts": {
        "build": "npm run css && tsc -p backend && tsc -p preload && tsc -p frontend",
        "dist": "npm run build && electron-builder",
        "dev": "concurrently \"npm run watch:css\" \"tsc -p backend -w\" \"tsc -p preload -w\" \"tsc -p frontend -w\" \"electronmon .\"",
        "css": "tailwindcss -i ./frontend/input.css -o ./frontend/dist/output.css",
        "watch:css": "tailwindcss -i ./frontend/input.css -o ./frontend/dist/output.css --watch",
        "format": "npx prettier --write .",
        "format:check": "npx prettier --check .",
        "test": "npm run build && node --test"
    },
    "repository": {
        "type": "git",
        "url": "git@github-2:live-miracles/live-gallery.git"
    },
    "keywords": [],
    "homepage": "https://github.com/live-miracles/live-gallery",
    "author": {
        "name": "Live Stream Miracles",
        "email": "live-miracles@users.noreply.github.com"
    },
    "license": "MIT",
    "type": "module",
    "build": {
        "appId": "com.livemiracles.livegallery",
        "productName": "Live Gallery",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "frontend/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "frontend/logo-256.ico",
            "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "frontend/logo.png",
            "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
            "category": "public.app-category.video"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "frontend/logo.png",
            "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
            "maintainer": "Live Stream Miracles <live-miracles@users.noreply.github.com>",
            "category": "Video"
        },
        "publish": {
            "provider": "github",
            "owner": "live-miracles",
            "repo": "live-gallery",
            "releaseType": "release"
        }
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.1",
        "@types/node": "^25.5.0",
        "@types/semver": "^7.7.1",
        "concurrently": "^9.2.1",
        "daisyui": "^5.5.19",
        "dotenv-cli": "^11.0.0",
        "electron": "^41.0.2",
        "electron-builder": "^26.8.1",
        "electronmon": "^2.0.4",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "electron-updater": "^6.8.3",
        "fast-xml-parser": "^5.5.6"
    }
}
